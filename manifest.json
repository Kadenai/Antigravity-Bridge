{
  "manifest_version": "0.3",
  "name": "agy-bridge",
  "display_name": "AGY Bridge",
  "version": "0.3.0",
  "description": "Execute tarefas do Antigravity CLI em projetos locais com limite de cinco instancias.",
  "author": { "name": "Levi" },
  "server": {
    "type": "node",
    "entry_point": "server/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/server/index.js"]
    }
  },
  "compatibility": {
    "platforms": ["win32"],
    "runtimes": { "node": ">=20.0.0" }
  }
}
